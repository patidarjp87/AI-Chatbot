
# Python virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python generated files
__pycache__/
*.py[cod]

# IDE settings
.vscode/

# Local test and coverage files
.pytest_cache/
.coverage
htmlcov/


# Generated videos and temp files (kept out of git; GitHub saves them as artifacts)
output/*
!output/.gitkeep
*.mp4
*.mp3
*.wav
tmp/

# Your own recordings and tokens
inputs/*
!inputs/.gitkeep
*token*.json
client_secret*.json

# OS junk
.DS_Store
Thumbs.db